# Copier ce fichier en .env et remplir les valeurs réelles.
# Le .env est ignoré par git (voir .gitignore).

OPENAI_API_KEY=sk-...
OPENALEX_API_KEY=...

# Secret de signature des liens de tracking (générer : openssl rand -base64 32)
API_SECRET_KEY=...

# URL publique où l'API est joignable (utilisée pour construire les liens trackés)
APP_BASE_URL=http://localhost:8000
